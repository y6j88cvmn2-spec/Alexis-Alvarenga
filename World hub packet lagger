local function clampToViewport(frame)
    local cam = workspace.CurrentCamera
    local vp = (cam and cam.ViewportSize) or Vector2.new(1280, 720)
    local abs = frame.AbsolutePosition
    local sz = frame.AbsoluteSize
    local dx, dy = 0, 0
    if abs.X < 6 then
        dx = 6 - abs.X
    elseif abs.X + sz.X > vp.X - 6 then
        dx = (vp.X - 6) - (abs.X + sz.X)
    end
    if abs.Y < 6 then
        dy = 6 - abs.Y
    elseif abs.Y + sz.Y > vp.Y - 6 then
        dy = (vp.Y - 6) - (abs.Y + sz.Y)
    end
    if dx ~= 0 or dy ~= 0 then
        local p = frame.Position
        frame.Position = UDim2.new(p.X.Scale, p.X.Offset + dx, p.Y.Scale, p.Y.Offset + dy)
    end
end

local function updateScale(delta)
    cfg.scale = math.clamp((cfg.scale or 1) + delta, 0.55, 1.9)
    tw(MainScale, { Scale = cfg.scale }, 0.16, Enum.EasingStyle.Quad)
    refreshSizeLabels()
    clampToViewport(Root)
    task.delay(0.2, function()
        clampToViewport(Root)
    end)
    if saveConfig then saveConfig() end
end

local function setSettingsOpen(open)
    settingsOpen = open == true
    cfg.settingsOpen = settingsOpen
    if settingsOpen then
        Settings.Visible = true
        Root.Size = UDim2.fromOffset(MAIN_W, MAIN_H + SET_H - 2)
    else
        Settings.Visible = false
        Root.Size = UDim2.fromOffset(MAIN_W, MAIN_H)
    end
    clampToViewport(Root)
    if saveConfig then saveConfig() end
end

local NET_INDEX_CANDIDATES = { 6, 230 }
local Event
local eventWatchActive = false

local function pickEvent(net)
    if not net then return nil end
    local ok, children = pcall(function() return net:GetChildren() end)
    if not ok or not children then return nil end
    for _, index in ipairs(NET_INDEX_CANDIDATES) do
        local candidate = children[index]
        if candidate and candidate:IsA("RemoteEvent") then
            return candidate
        end
    end
    for _, child in ipairs(children) do
        if child:IsA("RemoteEvent") then
            return child
        end
    end
    return nil
end

local function resolveEvent(waitForObjects)
    if Event and Event.Parent then
        return Event
    end
    local packages = RS:FindFirstChild("Packages")
    if not packages and waitForObjects then
        for _ = 1, 10 do
            task.wait(0.5)
            packages = RS:FindFirstChild("Packages")
            if packages then break end
        end
    end
    if not packages then return nil end
    local net = packages:FindFirstChild("Net")
    if not net and waitForObjects then
        task.wait(5)
        net = packages:FindFirstChild("Net")
    end
    if not net then return nil end
    Event = pickEvent(net)
    return Event
end

local function watchForEvent()
    if eventWatchActive or (Event and Event.Parent) then return end
    eventWatchActive = true
    task.spawn(function()
        for _ = 1, 20 do
            if Event and Event.Parent then break end
            resolveEvent(true)
            if Event and Event.Parent then break end
            task.wait(1)
        end
        eventWatchActive = false
    end)
end

resolveEvent(false)
watchForEvent()

local function paintPowerBtn()
    if lagging then
        tw(PowerBtn, { BackgroundColor3 = ACCENT, TextColor3 = DARK_TEXT }, 0.16)
        PowerBtn.Text = "Off"
        powerStroke.Color = ACCENT
        powerStroke.Transparency = 0.05
    else
        tw(PowerBtn, { BackgroundColor3 = INPUT_BG, TextColor3 = ACCENT }, 0.16)
        PowerBtn.Text = "Activate"
        powerStroke.Color = ACCENT
        powerStroke.Transparency = 0.3
    end
end

local function buildPacket(size)
    return table.create(size, function() end)
end

local function startLagging()
    if lagging then return end
    updatePower()
    if not (Event and Event.Parent) then
        resolveEvent(false)
    end
    if not (Event and Event.Parent) then
        watchForEvent()
        InfoLbl.Text = "event not ready · try again"
        return
    end
    lagging = true
    paintPowerBtn()
    local packet = buildPacket(intensity)
    local packetSize = intensity
    lagThread = task.spawn(function()
        local remote = Event
        while lagging do
            if packetSize ~= intensity then
                packet = buildPacket(intensity)
                packetSize = intensity
            end
            if not (remote and remote.Parent) then
                remote = resolveEvent(false) or remote
            end
            if remote then
                for _ = 1, 3 do
                    pcall(function()
                        remote:FireServer(packet)
                    end)
                end
            end
            task.wait(0.01)
        end
    end)
end

local function stopLagging()
    if not lagging then return end
    lagging = false
    if lagThread then
        pcall(task.cancel, lagThread)
        lagThread = nil
    end
    paintPowerBtn()
end

local function toggleLag()
    if lagging then
        stopLagging()
    else
        startLagging()
    end
end

saveConfig = function()
