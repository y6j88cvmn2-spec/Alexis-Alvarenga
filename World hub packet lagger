do
    local WALK_CONFIG_FILE = "M10RU_CFrameWalk_Config.json"
    local walkCfg = {
        studs = 8,
        delay = 0.1,
        keybind = "RightShift",
        withPacket = false,
    }

    if readfile and isfile and isfile(WALK_CONFIG_FILE) then
        local ok, saved = pcall(function()
            return HttpService:JSONDecode(readfile(WALK_CONFIG_FILE))
        end)
        if ok and type(saved) == "table" then
            if saved.studs ~= nil then walkCfg.studs = saved.studs end
            if saved.delay ~= nil then walkCfg.delay = saved.delay end
            if saved.keybind ~= nil then walkCfg.keybind = saved.keybind end
            if saved.withPacket ~= nil then walkCfg.withPacket = saved.withPacket == true end
        end
    end

    walkCfg.studs = tonumber(walkCfg.studs)
    if not (walkCfg.studs and walkCfg.studs > 0 and walkCfg.studs < math.huge) then
        walkCfg.studs = 8
    end
    walkCfg.delay = tonumber(walkCfg.delay)
    if not (walkCfg.delay and walkCfg.delay > 0 and walkCfg.delay < math.huge) then
        walkCfg.delay = 0.1
    end
    if type(walkCfg.keybind) ~= "string" or walkCfg.keybind == "" then
        walkCfg.keybind = "RightShift"
    end

    local function resolveWalkKey(name)
        local ok, key = pcall(function() return Enum.KeyCode[name] end)
        if ok and key and key ~= Enum.KeyCode.Unknown then
            return key
        end
        return nil
    end

    local walkKey = resolveWalkKey(walkCfg.keybind)
    if not walkKey then
        walkCfg.keybind = "RightShift"
        walkKey = Enum.KeyCode.RightShift
    end

    local function saveWalkSettings()
        pcall(function()
            if not writefile then return end
            writefile(WALK_CONFIG_FILE, HttpService:JSONEncode({
                studs = walkCfg.studs,
                delay = walkCfg.delay,
                keybind = walkCfg.keybind,
                withPacket = walkCfg.withPacket,
            }))
        end)
    end

    local studsBox = walkInput("WalkStudsBox", 14, 90, tostring(walkCfg.studs))
    local delayBox = walkInput("WalkDelayBox", 112, 90, tostring(walkCfg.delay))
    local walkKeyBox = walkKeyButton(210, 116, walkCfg.keybind)

    local function walkToggleButton(name, x, width)
        local button = Instance.new("TextButton")
        button.Name = name
        button.Size = UDim2.fromOffset(width, 30)
        button.Position = UDim2.fromOffset(x, 206)
        button.BackgroundColor3 = INPUT_BG_2
        button.BorderSizePixel = 0
        button.Text = ""
        button.TextColor3 = ACCENT
        button.Font = Enum.Font.GothamBold
        button.TextSize = 11
        button.AutoButtonColor = false
        button.ZIndex = 63
        button.Parent = Settings
        corner(button, 7)
        stroke(button, ACCENT, 1.1, 0.25)
        return button
    end

    local manualButton = walkToggleButton("WalkManualBtn", 14, 150)
    local walkButton = walkToggleButton("WalkWithPacketBtn", 174, 152)

    local walkActive = false
    local walkStartedBy = nil
    local walkRunId = 0
    local savedHumanoid = nil
    local savedWalkSpeed = nil

    local function restoreWalkSpeed()
        local hum, speed = savedHumanoid, savedWalkSpeed
        savedHumanoid = nil
        savedWalkSpeed = nil
        if hum and hum.Parent and speed ~= nil and hum.WalkSpeed == 0 then
            hum.WalkSpeed = speed
        end
    end

    local walkCastParams = RaycastParams.new()
    walkCastParams.FilterType = Enum.RaycastFilterType.Exclude
    walkCastParams.RespectCanCollide = true
    walkCastParams.IgnoreWater = true
    local WALL_CLEARANCE = 0.05
    local MAX_CAST_DISTANCE = 1000

    local function supportRadius(frame, size, normal)
        local n = frame:VectorToObjectSpace(normal)
        return 0.5 * (math.abs(n.X) * size.X + math.abs(n.Y) * size.Y + math.abs(n.Z) * size.Z)
    end

    local function safeWalkDelta(character, root, direction)
        local requested = direction * walkCfg.studs
        local distance = requested.Magnitude
        if distance <= 0 then return Vector3.new(0, 0, 0) end
        local unit = requested / distance
        distance = math.min(distance, MAX_CAST_DISTANCE)
        local castDirection = unit * distance
        local allowed = distance

        walkCastParams.FilterDescendantsInstances = { character }
        pcall(function() walkCastParams.CollisionGroup = root.CollisionGroup end)

        local bodyParts = { root }
        local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        local head = character:FindFirstChild("Head")
        if torso and torso:IsA("BasePart") then bodyParts[#bodyParts + 1] = torso end
        if head and head:IsA("BasePart") then bodyParts[#bodyParts + 1] = head end

        for _, part in ipairs(bodyParts) do
            local frame = part.CFrame
            local fullSize = part.Size
            local castSize = fullSize * 0.98
            local hit = workspace:Blockcast(frame, castSize, castDirection, walkCastParams)
            if hit then
                local approach = math.max(0.001, -unit:Dot(hit.Normal))
                local inset = supportRadius(frame, fullSize, hit.Normal) - supportRadius(frame, castSize, hit.Normal)
                local safeDistance = hit.Distance - (inset + WALL_CLEARANCE) / approach
                allowed = math.min(allowed, math.max(0, safeDistance))
            end

            local rayHit = workspace:Raycast(frame.Position, castDirection, walkCastParams)
            if rayHit then
                local approach = math.max(0.001, -unit:Dot(rayHit.Normal))
                local clearance = supportRadius(frame, fullSize, rayHit.Normal) + WALL_CLEARANCE
                local safeDistance = rayHit.Distance - clearance / approach
                allowed = math.min(allowed, math.max(0, safeDistance))
            end
            if allowed <= 0 then break end
        end
        return unit * allowed
    end

    local function walkStep()
        local character = LP.Character
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not (hum and root and hum.Health > 0) then
            restoreWalkSpeed()
            return
        end
        local direction = hum.MoveDirection
        if direction.Magnitude > 0 then
            if savedHumanoid ~= hum then
                restoreWalkSpeed()
                savedHumanoid = hum
                savedWalkSpeed = hum.WalkSpeed
            elseif hum.WalkSpeed ~= 0 then
                savedWalkSpeed = hum.WalkSpeed
            end
            hum.WalkSpeed = 0
            local delta = safeWalkDelta(character, root, direction)
            root.CFrame = root.CFrame + delta
        else
            restoreWalkSpeed()
        end
    end

    local function paintWalk()
        if not gui.Parent then return end
        local state = walkActive and "ACTIVE" or "OFF"
        walkStatus.Text = "CFrame Walk  ·  " .. state
        manualButton.Text = "CFrame: " .. (walkActive and "Off" or "Activate")
        manualButton.BackgroundColor3 = walkActive and ACCENT or INPUT_BG_2
        manualButton.TextColor3 = walkActive and DARK_TEXT or ACCENT
        walkButton.Text = "With Packet: " .. (walkCfg.withPacket and "Off" or "Activate")
        walkButton.BackgroundColor3 = walkCfg.withPacket and ACCENT or INPUT_BG_2
        walkButton.TextColor3 = walkCfg.withPacket and DARK_TEXT or ACCENT
    end

    local function setWalkActive(enabled, source)
        local wanted = gui.Parent ~= nil and enabled == true
        if wanted ~= walkActive then
            walkActive = wanted
            walkStartedBy = wanted and source or nil
            walkRunId = walkRunId + 1
            local currentRun = walkRunId
            if wanted then
                task.spawn(function()
                    while walkActive and walkRunId == currentRun and gui.Parent do
                        local ok = pcall(walkStep)
                        if not ok then restoreWalkSpeed() end
                        task.wait(walkCfg.delay)
                    end
                end)
            else
                restoreWalkSpeed()
            end
        end
        paintWalk()
    end

    local function toggleManualWalk()
        setWalkActive(not walkActive, "manual")
    end

    local function togglePacketLink()
        walkCfg.withPacket = not walkCfg.withPacket
        if walkCfg.withPacket and lagging then
            setWalkActive(true, "packet")
        elseif not walkCfg.withPacket and walkStartedBy == "packet" then
            setWalkActive(false, "packet")
        else
            paintWalk()
        end
        saveWalkSettings()
    end

    local function acceptNumber(box, key)
        local value = tonumber(box.Text)
        if value and value > 0 and value < math.huge then
            walkCfg[key] = value
        end
        box.Text = tostring(walkCfg[key])
        saveWalkSettings()
    end

    studsBox.FocusLost:Connect(function() acceptNumber(studsBox, "studs") end)
    delayBox.FocusLost:Connect(function() acceptNumber(delayBox, "delay") end)

    local walkListeningForKey = false
    walkKeyBox.MouseButton1Click:Connect(function()
        if walkListeningForKey then return end
        walkListeningForKey = true
        walkKeyBox.Text = "Press a key..."
        walkKeyBox.TextSize = 11
    end)

    UIS.InputBegan:Connect(function(input)
        if not walkListeningForKey then return end
        local keyboard = input.UserInputType == Enum.UserInputType.Keyboard
        local pad = isGamepadInput(input)
        if (keyboard or pad) and input.KeyCode ~= Enum.KeyCode.Unknown then
            local name = input.KeyCode.Name
            local key = resolveWalkKey(name)
            if key then
                walkCfg.keybind = name
                walkKey = key
                walkListeningForKey = false
                walkKeyBox.Text = walkCfg.keybind
                walkKeyBox.TextSize = (#walkCfg.keybind > 10) and 10 or 12
                saveWalkSettings()
            end
        end
    end)

    manualButton.MouseButton1Click:Connect(toggleManualWalk)
    walkButton.MouseButton1Click:Connect(togglePacketLink)

    local lastPacketState = lagging
    local heartbeatConn = RunService.Heartbeat:Connect(function()
        if not gui.Parent then
            if walkActive then
                walkActive = false
                walkStartedBy = nil
                restoreWalkSpeed()
            end
            return
        end
        if lagging ~= lastPacketState then
            lastPacketState = lagging
            if walkCfg.withPacket then setWalkActive(lagging, "packet") end
        end
    end)

    local inputConn = UIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or listeningForKey then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode == walkKey and input.KeyCode ~= toggleKey then
            toggleManualWalk()
        end
    end)

    gui.Destroying:Connect(function()
        heartbeatConn:Disconnect()
        inputConn:Disconnect()
        walkActive = false
        walkStartedBy = nil
        walkRunId = walkRunId + 1
        restoreWalkSpeed()
    end)

    if walkCfg.withPacket and lagging then
        setWalkActive(true, "packet")
    else
        paintWalk()
    end
    saveWalkSettings()
end

