local function tw(inst, props, dur, style, dir)
    TweenService:Create(inst, TweenInfo.new(dur or 0.16, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
end

local function corner(o, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 10)
    c.Parent = o
    return c
end

local function cornerFull(o)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = o
    return c
end

local function stroke(o, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col or ACCENT
    s.Thickness = th or 1.2
    s.Transparency = tr or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = o
    return s
end

local function makeGear(parent, px, color)
    local holder = Instance.new("Frame")
    holder.Name = "GearIcon"
    holder.AnchorPoint = Vector2.new(0.5, 0.5)
    holder.Position = UDim2.fromScale(0.5, 0.5)
    holder.Size = UDim2.fromOffset(px, px)
    holder.BackgroundTransparency = 1
    holder.ZIndex = (parent.ZIndex or 1) + 1
    holder.Parent = parent

    local r = px * 0.30
    for i = 0, 7 do
        local a = math.rad(i * 45)
        local tooth = Instance.new("Frame")
        tooth.Size = UDim2.fromOffset(math.max(2, px * 0.15), math.max(3, px * 0.30))
        tooth.AnchorPoint = Vector2.new(0.5, 0.5)
        tooth.Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r)
        tooth.Rotation = math.deg(a) + 90
        tooth.BackgroundColor3 = color
        tooth.BorderSizePixel = 0
        tooth.ZIndex = holder.ZIndex
        tooth.Parent = holder
        corner(tooth, 1)
    end

    local ring = Instance.new("Frame")
    ring.Size = UDim2.fromScale(0.62, 0.62)
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.fromScale(0.5, 0.5)
    ring.BackgroundColor3 = color
    ring.BorderSizePixel = 0
    ring.ZIndex = holder.ZIndex
    ring.Parent = holder
    cornerFull(ring)

    local hole = Instance.new("Frame")
    hole.Size = UDim2.fromScale(0.44, 0.44)
    hole.AnchorPoint = Vector2.new(0.5, 0.5)
    hole.Position = UDim2.fromScale(0.5, 0.5)
    hole.BackgroundColor3 = INPUT_BG_2
    hole.BorderSizePixel = 0
    hole.ZIndex = ring.ZIndex + 1
    hole.Parent = ring
    cornerFull(hole)

    return holder, ring, hole
end

