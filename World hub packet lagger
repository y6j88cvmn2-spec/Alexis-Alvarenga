local POWER_STEP = 5000
local MIN_POWER, MAX_POWER = 10000, 1000000

local function clampPower(v)
    v = tonumber(v)
    if not v then return intensity end
    return math.clamp(math.floor(v), MIN_POWER, MAX_POWER)
end

local saveConfig

local function updatePower()
    intensity = clampPower(PowerBox.Text)
    cfg.power = intensity
    PowerBox.Text = tostring(intensity)
    InfoLbl.Text = string.format("power %d  ·  key %s", intensity, toggleKeyName)
end

local function adjustPower(delta)
    intensity = math.clamp(intensity + delta, MIN_POWER, MAX_POWER)
    cfg.power = intensity
    PowerBox.Text = tostring(intensity)
    InfoLbl.Text = string.format("power %d  ·  key %s", intensity, toggleKeyName)
    if saveConfig then saveConfig() end
end

