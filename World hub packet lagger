local function isGamepadInput(input)
    return tostring(input.UserInputType.Name):match("^Gamepad") ~= nil
end

UIS.InputBegan:Connect(function(input, gpe)
    if listeningForKey then
        local keyboard = (input.UserInputType == Enum.UserInputType.Keyboard)
        local pad = isGamepadInput(input)
        if (keyboard or pad) and input.KeyCode ~= Enum.KeyCode.Unknown then
            listeningForKey = false
            applyKeybind(input.KeyCode.Name)
            saveConfig()
        end
        return
    end
    if gpe and not isGamepadInput(input) then return end
    if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode == toggleKey then
        toggleLag()
    end
end)

local dragState = nil

local function addDragHandle(obj)
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragState = { last = input.Position }
        end
    end)
end

addDragHandle(Main)
addDragHandle(MainTitle)
addDragHandle(MainSub)
addDragHandle(InfoLbl)
addDragHandle(Logo)

UIS.InputChanged:Connect(function(input)
    if not dragState then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = input.Position - dragState.last
    dragState.last = input.Position
    local p = Root.Position
    Root.Position = UDim2.new(p.X.Scale, p.X.Offset + d.X, p.Y.Scale, p.Y.Offset + d.Y)
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if dragState then
            dragState = nil
            saveConfig()
        end
    end
end)

