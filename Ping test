local function toggleSettings()
	settingsOpen = not settingsOpen
	if settingsOpen then
		settingsFrame.Visible = true
		settingsFrame.BackgroundTransparency = 1
		settingsFrame.Position = UDim2.new(0.5, -130, 0.5, -80)
		TweenService:Create(settingsFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
			BackgroundTransparency = 0.15,
			Position = UDim2.new(0.5, -130, 0.5, -105)
		}):Play()
		lagBtn.Visible = false
		presetRow.Visible = false
	else
		TweenService:Create(settingsFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, -130, 0.5, -80)
		}):Play()
		task.delay(0.2, function()
			settingsFrame.Visible = false
			lagBtn.Visible = true
			presetRow.Visible = true
		end)
	end
end

gearBtn.MouseButton1Click:Connect(toggleSettings)
