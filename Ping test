	local s = table.remove(cosmicPool, 1)
	if not s then return end
	local sx = math.random(0, 100)
	local size = math.random(4, 12)
	s.Position = UDim2.new(sx, 0, 0, -20)
	s.Size = UDim2.new(0, size, 0, size)
	s.BackgroundTransparency = 0
	sStroke.Transparency = 0
	
	local duration = math.random(20, 40) / 10
	TweenService:Create(s, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Position = UDim2.new(sx + math.random(-10, 10), 0, 1, 20),
		BackgroundTransparency = 1
	}):Play()
	TweenService:Create(sStroke, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Transparency = 1
	}):Play()
	
	task.delay(duration, function()
		table.insert(cosmicPool, s)
	end)
end

