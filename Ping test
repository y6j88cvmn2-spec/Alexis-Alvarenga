UserInputService.InputBegan:Connect(function(input, processed)
	local kc = input.KeyCode
	if kc == Enum.KeyCode.Unknown then return end
	if listeningFor then
		if kc == Enum.KeyCode.Escape then 
			listeningFor = false; kbBtn.Text = cfg.keybind; kbBtn.TextColor3 = C.accent; return 
		end
		if kc ~= Enum.KeyCode.LeftControl then 
			cfg.keybind = kc.Name; listeningFor = false; kbBtn.Text = cfg.keybind; kbBtn.TextColor3 = C.accent; saveConfig() 
		end
		return
	end
	if processed then return end
	local keyEnum = resolveKey(cfg.keybind)
	if keyEnum and kc == keyEnum then 
		active = not active; setLag(active)
		lagBtn.Text = active and "DEACTIVATE" or "ACTIVATE"
		lagBtn.TextColor3 = active and C.on or C.accent
		if active then
			TweenService:Create(lagBtn, TweenInfo.new(0.3), {BackgroundColor3 = C.on, TextColor3 = C.white}):Play()
		else
			TweenService:Create(lagBtn, TweenInfo.new(0.3), {BackgroundColor3 = C.card, TextColor3 = C.accent}):Play()
		end
	end
end)

