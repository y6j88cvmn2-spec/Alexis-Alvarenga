local function roseUrlLooksGood(url)
    if type(url) ~= "string" or url == "" then return false end
    if url:find("asset%-thumbnail/image", 1, false) then return false end
    return url:find("rbxassetid://", 1, true)
        or url:find("rbxasset://", 1, true)
        or url:find("rbxthumb://", 1, true)
        or url:find("getcustomasset", 1, true)
        or url:find("http://", 1, true)
        or url:find("https://", 1, true)
end

function M.resolveDecalImage(assetId, cdnUrl, fileName)
    assetId = tonumber(assetId)
    if not assetId then return "" end
    local cached = M._roseImageCache[assetId]
    if roseUrlLooksGood(cached) then
        return cached
    end
    local url

    -- Resolve the real Image id from the Decal via GetObjects / InsertService.
    if not roseUrlLooksGood(url) then
        pcall(function()
            local idUrl = "rbxassetid://" .. tostring(assetId)
            local getterTries = {
                function() return game:GetObjects(idUrl) end,
                function() return game.GetObjects(game, idUrl) end,
                function()
                    local g = rawget(game, "GetObjects")
                    return g and g(idUrl)
                end,
                function() return GetObjects(idUrl) end,
                function()
                    local g = getgenv and getgenv().GetObjects
                    return g and g(idUrl)
                end,
            }
            for _, tryGet in ipairs(getterTries) do
                local ok, objs = pcall(tryGet)
                if ok and objs then
                    local inst = objs[1] or objs
                    if inst then
                        if inst.IsA and (inst:IsA("Decal") or inst:IsA("Texture")) then
                            url = inst.Texture
                        elseif inst.FindFirstChildWhichIsA then
                            local d = inst:FindFirstChildWhichIsA("Decal", true) or inst:FindFirstChildWhichIsA("Texture", true)
                            if d then url = d.Texture end
                        end
                    end
                end
                if roseUrlLooksGood(url) then break end
            end
        end)
    end

    if not roseUrlLooksGood(url) then
        pcall(function()
            local model = game:GetService("InsertService"):LoadAsset(assetId)
            if model then
                local d = model:FindFirstChildWhichIsA("Decal", true) or model:FindFirstChildWhichIsA("Texture", true)
                if d then url = d.Texture end
                model:Destroy()
            end
        end)
    end

    -- 3) Download the thumbnail from rbxcdn and cache it locally.
    if not roseUrlLooksGood(url) and cdnUrl then
        pcall(function()
            if not (writefile and getcustomasset) then return end
            local fname = fileName or ("kuda_asset_" .. tostring(assetId) .. ".png")
            local hasFile = isfile and isfile(fname)
            if not hasFile then
                local body
                if syn and syn.request then
                    local r = syn.request({Url = cdnUrl, Method = "GET"})
                    body = r and (r.Body or r.body)
                elseif http_request then
                    local r = http_request({Url = cdnUrl, Method = "GET"})
                    body = r and (r.Body or r.body)
                elseif request then
                    local r = request({Url = cdnUrl, Method = "GET"})
                    body = r and (r.Body or r.body)
                elseif game.HttpGet then
                    body = game:HttpGet(cdnUrl)
                end
                if type(body) == "string" and #body > 200 then
                    writefile(fname, body)
                    hasFile = true
                end
            end
            if hasFile or (isfile and isfile(fname)) then
                url = getcustomasset(fname)
            end
        end)
    end

    -- 4) Protocol fallbacks. rbxthumb / rbxassetid often fail on Decal ids,
    -- but they are cheap to try if nothing else worked.
    if not roseUrlLooksGood(url) then
        url = "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=420&h=420"
    end

    if roseUrlLooksGood(url) then
        M._roseImageCache[assetId] = url
    end
    return url or ""
end

function M.roseVelvetUrl()
    if M.isWhiteTheme and M.isWhiteTheme() then
        return M.resolveDecalImage(M.WHITE_BG_ID, M.WHITE_BG_CDN, "kuda_white_bg.png")
    end
    return M.resolveDecalImage(M.ROSE_VELVET_ID, M.ROSE_VELVET_CDN, "kuda_velvet.png")
end

function M.roseLogoUrl()
    if M.isWhiteTheme and M.isWhiteTheme() then
        return M.resolveDecalImage(M.WHITE_LOGO_ID, M.WHITE_LOGO_CDN, "kuda_white_logo.png")
    end
    return M.resolveDecalImage(M.ROSE_LOGO_ID, M.ROSE_LOGO_CDN, "kuda_logo.png")
end

function M.trackRoseImage(img, kind)
    if not img then return img end
    M._roseTargets = M._roseTargets or {}
    table.insert(M._roseTargets, {img = img, kind = kind or "velvet"})
    local url = (kind == "logo") and M.roseLogoUrl() or M.roseVelvetUrl()
    if type(url) == "string" and url ~= "" then
        img.Image = url
    end
    return img
end

function M.flushRoseImages()
    local velvet = M.roseVelvetUrl()
    local logo = M.roseLogoUrl()
    for i = #(M._roseTargets or {}), 1, -1 do
        local t = M._roseTargets[i]
        if not t or not t.img or not t.img.Parent then
            table.remove(M._roseTargets, i)
        else
            local url = (t.kind == "logo") and logo or velvet
            if type(url) == "string" and url ~= "" then
                t.img.Image = url
            end
        end
    end
end

function M.startRoseImageRefresh()
    if M._roseRefreshStarted then return end
    M._roseRefreshStarted = true
    task.spawn(function()
        for _ = 1, 12 do
            pcall(function() M.flushRoseImages() end)
            task.wait(0.45)
        end
    end)
end

