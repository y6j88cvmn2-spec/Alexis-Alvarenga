            M.applyStealBarTheme(t.Accent)
            M.updateHeadTheme()
            saveCherryConfig()
            task.defer(function()
                local wasOpen = M.menuOpen ~= false
                applyAccentFromTheme()
                M.menuOpen = wasOpen
                M.buildGui()
                -- buildGui restores menuOpen from M.menuOpen
                pcall(function()
