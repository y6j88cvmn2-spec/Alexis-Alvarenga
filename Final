function M.applyAnimatedWhiteStroke(target, options)
    if not target then return nil end
    options = options or {}

    -- Roblox only draws one UIStroke per object. Keep a single themed
    -- rotating stroke instead of stacking a base + animated pair.
    local keepName = options.AnimatedName or "ThemeAnimatedStroke"
    for _, child in ipairs(target:GetChildren()) do
        if child:IsA("UIStroke") and child.Name ~= keepName then
            local n = child.Name
            if n == (options.BaseName or "WhiteBaseStroke")
                or n == "WhiteBaseStroke"
                or n == "AnimatedWhiteStroke"
                or n == "OpenPillEdge"
                or n == "RoseBtnStroke"
                or n == "RoseCardStroke" then
                child:Destroy()
            end
        end
    end

    local palette = M.themeStrokePalette()
    local stroke = getOrCreateUiComponent(target, "UIStroke", keepName)
    stroke.Color = palette.color
    stroke.Thickness = options.AnimatedThickness or options.BaseThickness or 2.15
    stroke.Transparency = options.AnimatedTransparency or 0.08
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local sweep = getOrCreateUiComponent(stroke, "UIGradient", options.GradientName or "RotatingThemeGradient")
    sweep:SetAttribute("PreserveGradient", true)
    sweep.Color = palette.sequence
    sweep.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0.00, 0.62),
        NumberSequenceKeypoint.new(0.22, 0.38),
        NumberSequenceKeypoint.new(0.38, 0.00),
        NumberSequenceKeypoint.new(0.50, 0.00),
        NumberSequenceKeypoint.new(0.62, 0.18),
        NumberSequenceKeypoint.new(0.80, 0.48),
        NumberSequenceKeypoint.new(1.00, 0.62),
    })
    sweep.Rotation = options.StartRotation or -90

    M.registerAnimatedStrokeGradient(sweep, options.Speed or 92)
    return stroke, stroke, sweep
end

