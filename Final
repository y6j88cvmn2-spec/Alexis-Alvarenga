local function report(...)
    local parts = {}
    for i = 1, select("#", ...) do parts[i] = tostring(select(i, ...)) end
    local message = "[Crimson] " .. table.concat(parts, " ")
    if type(rconsoleprint) == "function" then
        pcall(rconsoleprint, message .. "\n")
    elseif type(rconsolewarn) == "function" then
        pcall(rconsolewarn, message)
    else
        pcall(print, message)
    end
    pcall(function() warn(message) end)
end

