    local savedCenterY = math.clamp(
        math.clamp(tonumber(savedBarPos.y) or 0.68, 0, 1) * viewportAtBuild.Y,
        halfHAtBuild,
        math.max(halfHAtBuild, viewportAtBuild.Y - halfHAtBuild)
