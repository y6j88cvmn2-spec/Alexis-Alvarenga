        local halfH = math.max(1, MinPill.AbsoluteSize.Y * 0.5)
        local dragCenterX = math.clamp(pillStartCenter.X + delta.X, halfW, math.max(halfW, viewport.X - halfW))
        local dragCenterY = math.clamp(pillStartCenter.Y + delta.Y, halfH, math.max(halfH, viewport.Y - halfH))
        local scaleX, scaleY = dragCenterX / viewport.X, dragCenterY / viewport.Y

