-- ============================================================
-- BLACKOUT GLASS + ROTATING SIGNAL BORDER
-- The main window keeps a neutral dark gradient while a white highlight
-- continuously travels around its outline.  The animation is shared by all
-- registered gradients, so rebuilding the UI never creates render-step leaks.
-- ============================================================
M._animatedStrokeGradients = M._animatedStrokeGradients or {}
M._animatedStrokeConn = M._animatedStrokeConn or nil
M._animatedStrokeAccumulator = M._animatedStrokeAccumulator or 0

local function startAnimatedStrokeGradientLoop()
    if M._animatedStrokeConn then return end
    M._animatedStrokeAccumulator = 0

    M._animatedStrokeConn = RunService.RenderStepped:Connect(function(dt)
        -- Thirty updates per second keeps the rotating outline smooth while
        -- allowing every main-menu card to share the effect on mobile.
        M._animatedStrokeAccumulator = M._animatedStrokeAccumulator + dt
        if M._animatedStrokeAccumulator < (1 / 30) then return end
        local step = M._animatedStrokeAccumulator
        M._animatedStrokeAccumulator = 0

        local gradients = M._animatedStrokeGradients
        for i = #gradients, 1, -1 do
            local item = gradients[i]
            local gradient = item and item.gradient
            if not gradient or not gradient.Parent then
                table.remove(gradients, i)
            else
                gradient.Rotation = (gradient.Rotation + ((item.speed or 96) * step)) % 360
            end
        end

        -- Stop the loop when no animated borders are alive.  A later UI build
        -- starts it again when it registers its fresh border gradient.
        if #gradients == 0 then
            local conn = M._animatedStrokeConn
            M._animatedStrokeConn = nil
            if conn then conn:Disconnect() end
        end
    end)
end

function M.registerAnimatedStrokeGradient(gradient, speed)
    if not gradient then return end
    gradient:SetAttribute("PreserveGradient", true)

    for _, item in ipairs(M._animatedStrokeGradients) do
        if item.gradient == gradient then
            item.speed = speed or item.speed
            startAnimatedStrokeGradientLoop()
            return
        end
    end

    table.insert(M._animatedStrokeGradients, {
        gradient = gradient,
        speed = speed or 96,
    })
    startAnimatedStrokeGradientLoop()
end

local function getOrCreateUiComponent(parent, className, name)
    local child = parent:FindFirstChild(name)
    if child and not child:IsA(className) then
        child:Destroy()
        child = nil
    end
    if not child then
        child = Instance.new(className)
        child.Name = name
        child.Parent = parent
    end
    return child
end

