-- Use this on TextButtons, TextBoxes and TextLabels that need the dark glass
-- look. The background gradient lives in a separate sibling Frame so it cannot
-- tint or cover the text on the control itself.
function M.applyDarkTextControlStyle(control, options)
    if not control or not control.Parent then return nil end
    options = options or {}

    local prefix = options.Prefix or "DarkControl"
    local oldDirectGradient = control:FindFirstChild(prefix .. "DarkGradient")
    if oldDirectGradient and oldDirectGradient:IsA("UIGradient") then
        oldDirectGradient:Destroy()
    end

    -- Older builds placed the layer inside a TextButton/TextBox.  Roblox draws
    -- child GuiObjects above the control's own text in that case, so clean it
    -- up and use a sibling layer below the control instead.
    local oldChildBackground = control:FindFirstChild(prefix .. "Background")
    if oldChildBackground and oldChildBackground:IsA("Frame") then
        oldChildBackground:Destroy()
    end

    local host = control.Parent
    if not host:IsA("GuiObject") then return nil end

    -- In Sibling ZIndex mode a background below the parent card can disappear.
    -- Raise the text control above its card and keep a same-parent Frame just
    -- under it, guaranteeing labels/cursor are always rendered on top.
    local parentZ = host.ZIndex or 0
    control.ZIndex = math.max(control.ZIndex or 1, parentZ + 2)
    control.BackgroundTransparency = 1

    M._darkControlSerial = (M._darkControlSerial or 0) + 1
    local controlId = control:GetAttribute("DarkControlId")
    if not controlId then
        controlId = tostring(M._darkControlSerial)
        control:SetAttribute("DarkControlId", controlId)
    end
    local backgroundName = "__" .. prefix .. "Background_" .. tostring(controlId)
    local background = getOrCreateUiComponent(host, "Frame", backgroundName)
    background.Active = false
    background.Selectable = false
    background.Size = control.Size
    background.Position = control.Position
    background.AnchorPoint = control.AnchorPoint
    background.Rotation = control.Rotation
    background.LayoutOrder = control.LayoutOrder
    background.Visible = control.Visible
    background.BorderSizePixel = 0
    background.BackgroundTransparency = 0
    background.ZIndex = math.max(1, control.ZIndex - 1)

    local backgroundCorner = getOrCreateUiComponent(background, "UICorner", prefix .. "BackgroundCorner")
    local controlCorner = control:FindFirstChildOfClass("UICorner")
    if controlCorner then
        backgroundCorner.CornerRadius = controlCorner.CornerRadius
    else
        backgroundCorner.CornerRadius = UDim.new(0, options.CornerRadius or 7)
    end

    local darkGradient = M.applyDarkGradient(background, prefix .. "DarkGradient", options.Rotation or 135)
    local baseStroke = getOrCreateUiComponent(control, "UIStroke", prefix .. "SignalStroke")
    baseStroke.Color = Color3.fromRGB(68,68,68)
    baseStroke.Thickness = options.BaseThickness or 0.85
    baseStroke.Transparency = options.BaseTransparency or 0.58
    baseStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return darkGradient, background, baseStroke, nil, nil
end

