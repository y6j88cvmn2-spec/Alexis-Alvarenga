    local toggleStroke = Instance.new("UIStroke"); toggleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    toggleStroke.Color = UI_ACCENT; toggleStroke.Thickness = 1; toggleStroke.Transparency = on and 0.18 or 0.72; toggleStroke.Parent = tb
    local knob = Instance.new("Frame"); knob.Size = UDim2.new(0,16,0,16); knob.BorderSizePixel = 0
