        }, petal)
        table.insert(V.cyclonePetals, {
            object = petal,
            angle = angle,
            radius = radius,
            speed = 1.8 + math.random() * 2.7,
            phase = math.random() * TAU,
            baseX = petal.Size.X.Scale,
            baseY = petal.Size.Y.Scale,
        })
    end

    V.cycloneCore = New("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48),
        Size = UDim2.fromScale(0.04, 0.065), BackgroundTransparency = 1,
        Image = CIRCLE, ImageColor3 = C.Ivory,
        ImageTransparency = 1, ZIndex = 87,
    }, V.root)
    V.cycloneLabel = New("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.82),
        Size = UDim2.fromScale(0.38, 0.03), BackgroundTransparency = 1,
        Font = Enum.Font.Code, Text = "PETAL CURRENT // FORMING",
        TextColor3 = C.Blush, TextScaled = true, TextTransparency = 1,
        ZIndex = 89,
    }, V.root)

    -- Cinematic transition layer shared by transmission and cyclone acts.
    V.transitionLayer = New("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        ClipsDescendants = true, ZIndex = 92,
    }, V.root)

    local function petalWipe(reverse)
        play(sPetal, reverse and 0.88 or 1.18, 0.42)
        for i = 1, 26 do
            local startX = reverse and 1.2 + i * 0.025 or -0.2 - i * 0.025
            local endX = reverse and -0.25 or 1.25
            local petal = New("ImageLabel", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(startX, 0.06 + (i % 13) * 0.072),
                Size = UDim2.fromScale(0.14 + (i % 4) * 0.03, 0.21),
                BackgroundTransparency = 1, Image = CIRCLE,
                ImageColor3 = i % 4 == 0 and C.Ivory or C.Crimson,
                ImageTransparency = 0.06, Rotation = math.random(-30, 30),
                ZIndex = 93,
            }, V.transitionLayer)
            tween(petal, 0.72 + i * 0.008, {
                Position = UDim2.fromScale(endX, 0.06 + (i % 13) * 0.072),
                Rotation = petal.Rotation + math.random(90, 220),
                ImageTransparency = 0.5,
            }, Enum.EasingStyle.Exponential)
            Debris:AddItem(petal, 0.95)
        end
    end

    local function thornShutter()
        for i = 1, 9 do
            local bar = New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(i % 2 == 0 and 1.6 or -0.6, 0.02 + i * 0.115),
                Size = UDim2.fromScale(1.3, 0.09),
                BackgroundColor3 = i % 3 == 0 and C.Crimson or C.BlackRose,
                BorderSizePixel = 0, Rotation = -4, ZIndex = 94,
            }, V.transitionLayer)
            outline(bar, C.Blush, 1, 0.55)
            task.delay(i * 0.025, function()
                if bar.Parent then
                    tween(bar, 0.25, {Position = UDim2.fromScale(0.5, 0.02 + i * 0.115)}, Enum.EasingStyle.Exponential)
                    task.delay(0.1, function()
                        if bar.Parent then
                            tween(bar, 0.32, {Position = UDim2.fromScale(i % 2 == 0 and -0.7 or 1.7, 0.02 + i * 0.115)}, Enum.EasingStyle.Exponential)
                            Debris:AddItem(bar, 0.38)
                        end
                    end)
                end
            end)
        end
    end

    -- Timeline: transmission -> cyclone -> full-screen swarm -> falling reveal.
    task.delay(0.12, function()
        if ended then return end
        play(sClick, 1.25, 0.14)
        tween(V.transmission, 0.48, {BackgroundTransparency = 0.16})
        tween(V.transmissionStroke, 0.48, {Transparency = 0.3})
        tween(V.transmissionHeader, 0.48, {TextTransparency = 0.06})
        tween(V.transmissionMessage, 0.48, {TextTransparency = 0.14})
        tween(V.transmissionScan, 1.15, {Position = UDim2.fromScale(0, 0.98)}, Enum.EasingStyle.Linear)
        for _, data in ipairs(V.waveBars) do tween(data.object, 0.4, {BackgroundTransparency = 0.18}) end
    end)

    task.delay(0.62, function()
        if ended then return end
        for i, bar in ipairs(V.signalBars) do
            task.delay(i * 0.075, function()
                if bar.Parent then
                    tween(bar, 0.16, {BackgroundTransparency = 0.08}, Enum.EasingStyle.Back)
                    play(sClick, 1.1 + i * 0.08, 0.06)
                end
            end)
        end
    end)

    task.delay(1.08, function()
        if ended then return end
        V.transmissionHeader.Text = "ROSELINK // CYCLONE CHANNEL SECURE"
        V.transmissionMessage.Text = "PETAL PRESSURE RISING // OPENING GATE"
        play(sSignal, 1.28, 0.3)
    end)

    task.delay(1.48, function()
        if ended then return end
        petalWipe(false)
        tween(V.transmissionShade, 0.72, {BackgroundTransparency = 1})
        tween(V.transmission, 0.56, {BackgroundTransparency = 1, Position = UDim2.fromScale(0.5, 0.46)})
        tween(V.transmissionStroke, 0.46, {Transparency = 1})
        tween(V.transmissionHeader, 0.4, {TextTransparency = 1})
        tween(V.transmissionMessage, 0.4, {TextTransparency = 1})
        for _, bar in ipairs(V.signalBars) do tween(bar, 0.35, {BackgroundTransparency = 1}) end
        for _, data in ipairs(V.waveBars) do tween(data.object, 0.35, {BackgroundTransparency = 1}) end
    end)

    task.delay(1.95, function()
        if ended then return end
        V.cycloneActive = true
        V.cycloneStarted = os.clock()
        V.cycloneMode = "spin"
        tween(V.cycloneLabel, 0.4, {TextTransparency = 0.12})
        tween(V.cycloneCore, 0.6, {ImageTransparency = 0.5, Size = UDim2.fromScale(0.18, 0.29)})
        tween(V.backGlow, 0.9, {ImageTransparency = 0.48})
        play(sBloom, 0.7, 0.5)
        play(sPetal, 0.86, 0.34)
    end)

    task.delay(2.85, function()
        if ended then return end
        V.cycloneLabel.Text = "PETAL VELOCITY // RISING"
        play(sSignal, 1.52, 0.2)
        tween(V.cycloneCore, 0.45, {ImageTransparency = 0.3, Size = UDim2.fromScale(0.28, 0.45)})
    end)

    task.delay(4.15, function()
        if ended then return end
        V.cycloneLabel.Text = "ROSE CYCLONE // MAXIMUM BLOOM"
        play(sPetal, 1.35, 0.42)
        tween(V.backGlow, 0.4, {ImageTransparency = 0.34})
    end)

    task.delay(4.9, function()
        if ended then return end
        V.cycloneMode = "compress"
        V.cycloneStage = os.clock()
        V.cycloneLabel.Text = "CYCLONE CORE // COMPRESSING"
        play(sImpact, 0.82, 0.46)
        tween(V.cycloneCore, 0.68, {Size = UDim2.fromScale(0.08, 0.13), ImageTransparency = 0.08}, Enum.EasingStyle.Exponential)
    end)

    task.delay(5.65, function()
        if ended then return end
        V.cycloneActive = false
        V.cycloneMode = "swarm"
        V.cycloneLayer.ZIndex = 96
        V.cycloneLabel.TextTransparency = 1
        play(sSlash, 0.76, 0.64)
        play(sImpact, 0.62, 0.72)
        for i, data in ipairs(V.cyclonePetals) do
            local column = (i - 1) % 12
            local row = math.floor((i - 1) / 12)
            data.object.ZIndex = 96
            tween(data.object, 0.46 + (i % 7) * 0.018, {
                Position = UDim2.fromScale((column + 0.5) / 12, (row + 0.5) / 10),
                Size = UDim2.fromScale(0.13, 0.16),
                Rotation = math.random(-35, 35),
                BackgroundTransparency = 0,
            }, Enum.EasingStyle.Exponential)
        end
        tween(V.cycloneCore, 0.24, {ImageTransparency = 1})
    end)

    task.delay(6.3, function()
        if ended then return end
        -- Build the title and rose behind the opaque petal swarm.
        for i, data in ipairs(V.petals) do
            data.object.Position = data.target
            data.object.Size = data.targetSize
            data.object.Rotation = data.targetRotation
        end
        tween(V.titleGlass, 0.01, {BackgroundTransparency = 0.18})
        V.titleStroke.Transparency = 0.42
        V.titleRed.TextTransparency = 0.25
        V.title.TextTransparency = 0
        V.subtitle.TextTransparency = 0.08
        V.leftHUD.TextTransparency = 0.24
        V.rightHUD.TextTransparency = 0.24
    end)

    task.delay(6.52, function()
        if ended then return end
        play(sPetal, 0.72, 0.58)
        play(sFlash, 1.06, 0.38)
        -- The swarm falls in staggered columns, revealing Crimson.
        for i, data in ipairs(V.cyclonePetals) do
            local column = (i - 1) % 12
            task.delay(column * 0.045 + math.random() * 0.06, function()
                if data.object.Parent then
                    tween(data.object, 0.82 + math.random() * 0.35, {
                        Position = UDim2.new(data.object.Position.X.Scale + (math.random() - 0.5) * 0.12, 0, 1.28 + math.random() * 0.25, 0),
                        Size = UDim2.fromScale(0.045, 0.07),
                        Rotation = data.object.Rotation + math.random(-240, 240),
                        BackgroundTransparency = 0.18,
                    }, Enum.EasingStyle.Quart)
                end
            end)
        end
    end)

    task.delay(7.25, function()
        if ended then return end
        play(sFinal, 0.86, 0.5)
        tween(V.titleGlass, 0.3, {Size = UDim2.fromScale(0.78, 0.3)}, Enum.EasingStyle.Back)
        tween(V.rose, 0.55, {Size = UDim2.fromOffset(360, 360), Rotation = 14}, Enum.EasingStyle.Back)
        task.delay(0.3, function()
            if V.titleGlass.Parent then tween(V.titleGlass, 0.32, {Size = UDim2.fromScale(0.72, 0.27)}, Enum.EasingStyle.Back) end
        end)
    end)

    task.delay(8.35, function()
        if ended then return end
        V.subtitle.Text = "FROM THE STORM // THE ROSE REMAINS"
        V.leftHUD.Text = "PETAL CYCLONE // DISSIPATED"
        V.rightHUD.Text = "Crimson // REVEALED"
        tween(V.roseCore, 0.4, {ImageTransparency = 0.2, Size = UDim2.fromScale(0.48, 0.48)})
        play(sSignal, 0.92, 0.24)
    end)

    task.delay(9.75, function()
        if ended then return end
        petalWipe(true)
        play(sBloom, 1.06, 0.32)
        tween(V.titleRed, 0.25, {Position = UDim2.new(0.5, -10, 0.5, 6)}, Enum.EasingStyle.Back)
    end)

    -- Continuous garden and cyclone motion.
    local render = RunService.RenderStepped:Connect(function(dt)
        if ended or not gui.Parent then return end
        local t = os.clock() - started
        if V.cycloneActive then
            local cycloneElapsed = os.clock() - V.cycloneStarted
            local compression = 0
            if V.cycloneMode == "compress" and V.cycloneStage then
                compression = math.clamp((os.clock() - V.cycloneStage) / 0.75, 0, 0.88)
            end
            local acceleration = 1 + math.min(cycloneElapsed * 0.22, 1.35)
            for _, data in ipairs(V.cyclonePetals) do
                local angle = data.angle + cycloneElapsed * data.speed * acceleration
                local breathe = 1 + math.sin(cycloneElapsed * 3 + data.phase) * 0.08
                local radius = data.radius * breathe * (1 - compression)
                data.object.Position = UDim2.fromScale(
                    0.5 + math.cos(angle) * radius,
                    0.48 + math.sin(angle) * radius * 0.68
                )
                data.object.Rotation = math.deg(angle) + cycloneElapsed * data.speed * 28
                local scaleBoost = 1 + math.min(cycloneElapsed * 0.08, 0.45)
                data.object.Size = UDim2.fromScale(data.baseX * scaleBoost, data.baseY * scaleBoost)
            end
            V.cycloneCore.Rotation = V.cycloneCore.Rotation + dt * 46
            V.cycloneCore.ImageTransparency = math.clamp(V.cycloneCore.ImageTransparency + math.sin(t * 7) * dt * 0.08, 0.12, 0.58)
        end
        for _, data in ipairs(V.waveBars) do
            local height = 0.05 + math.abs(math.sin(t * 8 + data.phase)) * 0.16
            data.object.Size = UDim2.fromScale(0.009, height)
        end
        if sHum then pcall(function()
            sHum.Volume = 0.06 + math.clamp(t / DURATION, 0, 1) * 0.05
            sHum.PlaybackSpeed = 0.68 + math.clamp(t / DURATION, 0, 1) * 0.16
        end) end
        V.backGlow.Rotation = V.backGlow.Rotation + dt * 3
        V.backGlow.ImageTransparency = 0.56 + math.sin(t * 2.2) * 0.07
        V.rose.Rotation = V.rose.Rotation + dt * 1.4
        V.roseCore.ImageTransparency = 0.48 + math.sin(t * 4) * 0.09

        for _, data in ipairs(V.petals) do
            data.object.BackgroundTransparency = 0.04 + math.sin(t * 2.5 + data.phase) * 0.035
        end
        for _, data in ipairs(V.stars) do
            data.object.BackgroundTransparency = 0.58 + math.sin(t * 3 + data.phase) * 0.25
        end
        for _, data in ipairs(V.pollen) do
            local x = data.object.Position.X.Scale + math.sin(t + data.phase) * dt * 0.01
            local y = data.object.Position.Y.Scale - data.speed * dt
            if y < 0.1 then y = 0.95; x = math.random() end
            data.object.Position = UDim2.fromScale(x, y)
            data.object.ImageTransparency = 0.78 + math.sin(t * 4 + data.phase) * 0.1
        end
        for _, data in ipairs(V.vines) do
            data.stem.Rotation = data.stem.Rotation + math.sin(t * 1.8 + data.phase) * dt * 2
            data.thorn.BackgroundTransparency = 0.38 + math.sin(t * 3 + data.phase) * 0.12
        end
        for _, data in ipairs(V.reflections) do
            data.object.Size = UDim2.fromScale(data.width * (0.9 + math.sin(t * 3 + data.phase) * 0.12), 0.002)
        end
        for _, data in ipairs(V.loosePetals) do
            local x = data.object.Position.X.Scale + math.sin(t * 2 + data.phase) * dt * 0.035
            local y = data.object.Position.Y.Scale + data.speed * dt
            if y > 1.06 then y = -0.06; x = math.random() end
            data.object.Position = UDim2.fromScale(x, y)
            data.object.Rotation = data.object.Rotation + dt * 75
        end
        V.left.coat.Rotation = 9 + math.sin(t * 2) * 3
        V.right.coat.Rotation = -9 - math.sin(t * 2) * 3
        V.left.glow.ImageTransparency = 0.6 + math.sin(t * 5) * 0.08
        V.right.glow.ImageTransparency = 0.6 + math.sin(t * 5 + 1) * 0.08
    end)

    local function finish()
        if ended then return end
        ended = true
        render:Disconnect()
        if sHum then pcall(function() sHum:Stop() end) end
        for _, object in ipairs(V.root:GetDescendants()) do
            if object:IsA("Frame") then
                tween(object, 0.75, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
            elseif object:IsA("TextLabel") then
                tween(object, 0.75, {TextTransparency = 1, TextStrokeTransparency = 1, BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
            elseif object:IsA("ImageLabel") then
                tween(object, 0.75, {ImageTransparency = 1, BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
            elseif object:IsA("UIStroke") then
                tween(object, 0.75, {Transparency = 1}, Enum.EasingStyle.Quad)
            end
        end
        tween(V.root, 0.75, {BackgroundTransparency = 1})
        task.delay(0.85, function()
            if gui then gui:Destroy() end
            for _, object in ipairs(sounds) do pcall(function() object:Destroy() end) end
        end)
    end

    task.spawn(function()
        local remaining = DURATION - (os.clock() - started)
        if remaining > 0 then task.wait(remaining) end
        finish()
    end)

    task.delay(DURATION + 2, function()
        if gui and gui.Parent then gui:Destroy() end
    end)
end)

if not ok then report("ERROR:", err) end

    end

    -- The Rose intro schedules its timeline asynchronously. Wait for it to
    -- finish so the main Crimson interface does not appear over the cinematic.
    do
        local function findRoseIntro()
            local pg = player and player:FindFirstChild("PlayerGui")
            local found = pg and pg:FindFirstChild("Crimson_ThornGarden")
            if found then return found end
            local okCore, coreFound = pcall(function()
                return game:GetService("CoreGui"):FindFirstChild("Crimson_ThornGarden")
            end)
            return okCore and coreFound or nil
        end

        local introDeadline = os.clock() + 15
        local activeIntro = findRoseIntro()
        while activeIntro and os.clock() < introDeadline do
            task.wait(0.05)
            activeIntro = findRoseIntro()
        end

        if activeIntro then
            pcall(function() activeIntro:Destroy() end)
        end
    end
end

