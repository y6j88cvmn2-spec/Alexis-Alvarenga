local function applyGuiScale(v)
	v = math.clamp(tonumber(v) or 1, 0.7, 1.4)
	cfg.guiScale = v
	mainScale.Scale = v
	local t = math.clamp((v - 0.7) / 0.7, 0, 1)
	scaleFill.Size = UDim2.new(t, 0, 1, 0)
	if scaleKnob then scaleKnob.Position = UDim2.new(t, 0, 0.5, 0) end
	scaleVal.Text = string.format("%.0f%%", v * 100)
	saveConfig()
end

local draggingScale = false
local function scaleFromInput(x)
	local abs = scaleTrack.AbsolutePosition.X
	local w = scaleTrack.AbsoluteSize.X
	if w < 1 then return end
	local t = math.clamp((x - abs) / w, 0, 1)
	applyGuiScale(0.7 + t * 0.7)
end

local function bindScaleDrag(obj)
	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingScale = true
			scaleFromInput(input.Position.X)
		end
	end)
end
