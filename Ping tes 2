	local duration = math.random(18, 36) / 10
	TweenService:Create(s, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Position = UDim2.new((sx + math.random(-8, 8)) / 100, 0, 1.05, 0),
		BackgroundTransparency = 1,
