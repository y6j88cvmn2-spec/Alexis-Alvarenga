local SONGS = {
	{ name = "funk 1", url = "https://files.catbox.moe/mfcis6.mp3", file = "AXEHUB_funk1.mp3", soundName = "AXEHUB_Funk1" },
	{ name = "funk 2", url = "https://files.catbox.moe/paz5vs.mp3", file = "AXEHUB_funk2.mp3", soundName = "AXEHUB_Funk2" },
}

local songSounds = {} -- [index] = Sound
local songPlaying = {} -- [index] = bool

local function ensureSongAt(i)
	local meta = SONGS[i]
	if not meta then return nil end
	if songSounds[i] and songSounds[i].Parent then return songSounds[i] end
	local id = meta.url
	pcall(function()
		if writefile and isfile and getcustomasset then
			if not isfile(meta.file) then
				local data = game:HttpGet(meta.url)
				if data and #data > 100 then writefile(meta.file, data) end
			end
			if isfile(meta.file) then
				id = getcustomasset(meta.file)
			end
		end
	end)
	local s = Instance.new("Sound")
	s.Name = meta.soundName
	s.SoundId = id
	s.Volume = 0.65
	s.Looped = true
	s.Parent = SoundService
	songSounds[i] = s
	return s
end

local function setSongAt(i, on)
	songPlaying[i] = on and true or false
	local s = ensureSongAt(i)
	if not s then return end
	if on then
		pcall(function() s:Play() end)
	else
		pcall(function() s:Stop() end)
	end
	-- cfg.songOn = any playing
	local any = false
	for _, v in pairs(songPlaying) do if v then any = true break end end
	cfg.songOn = any
	saveConfig()
end

local function stopAllSongs()
	for i = 1, #SONGS do
		songPlaying[i] = false
		if songSounds[i] then pcall(function() songSounds[i]:Stop() end) end
	end
	cfg.songOn = false
	pcall(function()
		for _, s in ipairs(SoundService:GetChildren()) do
			if s:IsA("Sound") then
				local n = s.Name:lower()
				if n:find("axe") or n:find("funk") then
					pcall(function() s:Stop() end)
				end
			end
		end
	end)
	saveConfig()
end

