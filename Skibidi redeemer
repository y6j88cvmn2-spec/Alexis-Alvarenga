local BOX_WAIT = 0.25  -- tight: if box isn't ready in 250ms just fire anyway
local function waitForBox(box, timeout)
    if box.Active then return true end
    local deadline = os.clock() + timeout
    while not box.Active do
        if os.clock() > deadline or not box.Parent then return true end  -- don't block, fire anyway
        RunService.Heartbeat:Wait()
    end
    return true
end

