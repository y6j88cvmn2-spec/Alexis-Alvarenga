local function clampPower(v)
    v = tonumber(v)
    if not v then return power end
    return math.clamp(math.floor(v), 1, 100000)
end

local function setPower(v)
    power = clampPower(v)
    PowerBox.Text = tostring(power)
end

local function applyScale(s)
    guiScale = math.clamp(s, 0.6, 1.4)
    UIScale.Scale = guiScale
