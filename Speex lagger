-- NET REMOTE
local function findEvent()
    local function pick(net)
        if not net then return nil end
        local kids = net:GetChildren()
        if kids[230] and kids[230]:IsA("RemoteEvent") then return kids[230] end
        for i = #kids, 1, -1 do
            if kids[i]:IsA("RemoteEvent") then return kids[i] end
        end
        for _, c in ipairs(kids) do
            if c:IsA("RemoteEvent") then return c end
        end
        return nil
    end
    local packages = RS:FindFirstChild("Packages")
    if packages then
        local ev = pick(packages:FindFirstChild("Net"))
        if ev then return ev end
    end
    local ok, net = pcall(function()
        local p = RS:WaitForChild("Packages", 2)
        return p and p:WaitForChild("Net", 2)
    end)
    if ok and net then return pick(net) end
    return nil
end

local function resolveEvent()
    Event = findEvent()
    if Event then
        setStatus("READY", C.green)
        return true
    end
    setStatus("NO NET REMOTE", C.red)
    return false
end

local function startLag()
    if lagging then return end
    if not Event or not Event.Parent then
        if not resolveEvent() then return end
    end
    power = clampPower(PowerBox.Text)
    PowerBox.Text = tostring(power)
    lagging = true
    paintStart()
    setStatus("SPEEX ON - " .. power .. " [" .. mode .. "]", C.green)

    -- Speex style payload — does not block local grab/carry
    local payload = table.create(power, function() end)

    lagThread = task.spawn(function()
        while lagging do
            if not Event or not Event.Parent then
                resolveEvent()
                if not Event then
                    task.wait(0.4)
                    continue
                end
            end

            local m = MODES[mode] or MODES.V2
            local copies = m.copies or 1

            -- fire hard so opponents lag / rubberband; local can still grab brain
            for _ = 1, m.bursts do
                for _ = 1, copies do
                    pcall(function()
                        Event:FireServer(payload)
                    end)
                end
            end

            task.wait(m.wait)
        end
    end)
end

local function stopLag()
    if not lagging then return end
    lagging = false
    if lagThread then pcall(task.cancel, lagThread); lagThread = nil end
    paintStart()
    setStatus("IDLE", C.dim)
end

local function saveCfg()
    power = clampPower(PowerBox.Text)
    if writefile then
        pcall(function()
            writefile(CONFIG_FILE, HttpService:JSONEncode({
                Power = power,
                Mode = mode,
                Keybind = toggleKeyName,
                Scale = guiScale,
                Locked = locked,
                PX_S = Main.Position.X.Scale, PX_O = Main.Position.X.Offset,
                PY_S = Main.Position.Y.Scale, PY_O = Main.Position.Y.Offset,
            }))
        end)
    end
end

local function loadCfg()
    if not (readfile and isfile and isfile(CONFIG_FILE)) then return end
    local ok, cfg = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if not (ok and type(cfg) == "table") then return end
    if tonumber(cfg.Power) then setPower(cfg.Power) end
    if type(cfg.Mode) == "string" and MODES[cfg.Mode] then mode = cfg.Mode end
    if tonumber(cfg.Scale) then applyScale(cfg.Scale) end
    if type(cfg.Locked) == "boolean" then locked = cfg.Locked; paintLock() end
    if type(cfg.Keybind) == "string" and cfg.Keybind ~= "" then
        toggleKeyName = cfg.Keybind
        local ok2, k = pcall(function() return Enum.KeyCode[toggleKeyName] end)
        if ok2 and k then toggleKey = k end
        KeyBtn.Text = toggleKeyName
    end
    if tonumber(cfg.PX_S) and tonumber(cfg.PX_O) and tonumber(cfg.PY_S) and tonumber(cfg.PY_O) then
        Main.Position = UDim2.new(cfg.PX_S, cfg.PX_O, cfg.PY_S, cfg.PY_O)
    end
end

